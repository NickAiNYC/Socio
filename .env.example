# Socio Operating System - Environment Variables

# ==========================================
# 1. Core Architecture (DSH & VPS)
# ==========================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
VPS_IP=your_droplet_ip_here

# ==========================================
# 2. Database & Command Center
# ==========================================
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
TASKADE_API_KEY=your_taskade_api_key_here

# ==========================================
# 3. Prospecting & Listings (Socio-Prospect & Socio-Listings)
# ==========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
YELP_API_KEY=your_yelp_api_key_here
INSTAGRAM_SESSION_ID=your_instagram_session_id_here
SYNUP_API_KEY=your_synup_api_key_here

# ==========================================
# 4. Outreach & Support (Socio-Pitch & Socio-Support)
# ==========================================
RESEND_API_KEY=your_resend_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
INTERCOM_ACCESS_TOKEN=your_intercom_access_token_here

# ==========================================
# 5. Onboarding (Socio-Onboard)
# ==========================================
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key_here
TYPEFORM_PERSONAL_TOKEN=your_typeform_token_here

# ==========================================
# 6. Content Engine (Socio-Content)
# ==========================================
HELIO_API_KEY=your_helio_api_key_here
CANVA_API_KEY=your_canva_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ==========================================
# 7. Financial Tracking (Socio-Track)
# ==========================================
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here

# ==========================================
# 8. Merchant Evidence Layer (Growth OS)
# ==========================================
# Read-only reporting API for merchants. Binds 127.0.0.1 by default.
MERCHANT_API_PORT=8787
MERCHANT_API_HOST=127.0.0.1
# Per-business bearer tokens; when set, every request must authenticate and
# the path businessId must equal the token's businessId (server-side isolation).
MERCHANT_API_TOKENS={"socio_default":"change-me"}
# REQUIRED in production (DATABASE_URL set): the dashboard serves financial
# evidence, so the API refuses to boot without an explicit allowed origin.
MERCHANT_API_CORS_ORIGIN=https://pilot.yourdomain.com
# Stripe webhook receiver (pilot wiring): public HTTPS endpoint in front of
# 127.0.0.1:8789/api/webhooks/stripe. STRIPE_WEBHOOK_SECRET is required; the
# receiver fails closed without it.
STRIPE_WEBHOOK_PORT=8789
STRIPE_WEBHOOK_HOST=127.0.0.1
STRIPE_WEBHOOK_MAX_BODY_BYTES=1000000
STRIPE_WEBHOOK_RATE_LIMIT=120
# Explicit in-memory test mode only — production requires DATABASE_URL.
GROWTH_OS_ALLOW_MEMORY=false

# ==========================================
# 9. Socio Web Server & Hermes Webhooks
# ==========================================
PORT=3030
WEBHOOK_SECRET=your_production_webhook_secret_here
# Fail-closed: server.js refuses to boot with a weak/known ADMIN_PASSWORD.
# Generate one with: openssl rand -hex 24
ADMIN_PASSWORD=generate_a_strong_32_char_random_key_here
SOCIO_HERMES_PROFILE=socio-support
DATABASE_URL=postgres://user:password@localhost:5432/socio

# ==========================================
# 10. WhatsApp Business Cloud API (Meta Graph API v20.0+)
# ==========================================
# Get these from Meta Developer Portal > your App > WhatsApp > API Setup
# and Business Settings > System Users > Permanent Token
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=your_permanent_system_user_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate_a_random_verify_token_here
# Phone number in E.164 digits without + for wa.me deep links (e.g., 19175551234)
WHATSAPP_DISPLAY_PHONE_NUMBER=19175551234
META_GRAPH_API_VERSION=v20.0
# Legacy aliases (still read if new names absent) — prefer the names above
# WHATSAPP_TOKEN, WHATSAPP_VERIFY_TOKEN, WHATSAPP_WABA_ID

# ==========================================
# 11. Meta Pixel + Conversions API + Instagram/Messenger (missing servicers)
# ==========================================
# Pixel + CAPI — dedupe browser pixel events server-side
META_PIXEL_ID=your_pixel_id_here
META_CAPI_TOKEN=your_capi_system_user_token_here
META_TEST_EVENT_CODE=test_code_from_events_manager
# Instagram Graph (replace scraping via INSTAGRAM_SESSION_ID)
IG_BUSINESS_ACCOUNT_ID=your_ig_business_account_id_here
META_PAGE_ID=your_facebook_page_id_here
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
# Ads — Click-to-WhatsApp attribution
AD_ACCOUNT_ID=act_your_ad_account_id
# WhatsApp Flows (permit intake, subscription flow)
WHATSAPP_FLOW_IDS={"permit_intake":"your_flow_id","subscription":"your_flow_id_2"}
# Infra for Meta servicers
REDIS_URL=redis://localhost:6379
S3_BUCKET=socio-media-uploads
S3_REGION=us-east-1

