datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadSource {
  WHATSAPP
  INBOUND_CALL
  DOB_PERMIT_SCAN
  WEB_FORM
}

enum ContractStatus {
  BID_SUBMITTED
  DEPOSIT_PENDING
  DEPOSIT_CLEARED
  IN_PROGRESS
  FINAL_INVOICED
  COMPLETED
}

enum CommissionStatus {
  PENDING_DEPOSIT
  DUE
  INVOICED
  PAID
  CAPPED_OUT
}

model Contractor {
  id                  String               @id @default(uuid())
  businessName        String
  ownerName           String
  phone               String               @unique
  email               String               @unique
  borough             String               @default("Queens") // Queens, Brooklyn, Bronx, Manhattan, Staten Island
  licenseNumber       String?              // NYC DCA / DOB Contractor License
  qboRealmId          String?              @unique
  qboAccessToken      String?              @db.Text
  qboRefreshToken     String?              @db.Text
  qboTokenExpiresAt   DateTime?
  annualCommissionCap Decimal              @default(40000.00) @db.Decimal(12, 2)
  flatSaaSMonthlyRate Decimal              @default(1500.00)  @db.Decimal(12, 2)
  isCapped            Boolean              @default(false)
  currentYearBilled   Decimal              @default(0.00)     @db.Decimal(12, 2)
  gbpReviewLink       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  leads               Lead[]
  contracts           Contract[]
  commissionEvents    CommissionLedger[]

  @@index([phone, email])
}

model Lead {
  id                  String               @id @default(uuid())
  contractorId        String
  clientName          String
  clientPhone         String
  clientEmail         String?
  projectAddress      String?
  estimatedScope      String?
  source              LeadSource           @default(WHATSAPP)
  rawTrackingPhone    String?              // Dedicated tracking number caller reached
  dobPermitJobNumber  String?
  createdAt           DateTime             @default(now())

  contractor          Contractor           @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  contracts           Contract[]

  @@index([contractorId, clientPhone, clientEmail])
}

model Contract {
  id                  String               @id @default(uuid())
  contractorId        String
  leadId              String?
  qboInvoiceId        String?              @unique
  qboEstimateId       String?
  projectDescription  String
  totalContractAmount Decimal              @db.Decimal(12, 2)
  depositRequired     Decimal              @db.Decimal(12, 2)
  depositClearedAmount Decimal             @default(0.00) @db.Decimal(12, 2)
  status              ContractStatus       @default(BID_SUBMITTED)
  depositClearedAt    DateTime?
  finalPaymentAt      DateTime?
  reviewRequestedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  contractor          Contractor           @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  lead                Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  commissions         CommissionLedger[]

  @@index([contractorId, qboInvoiceId])
}

model CommissionLedger {
  id                  String               @id @default(uuid())
  contractorId        String
  contractId          String
  contractAmount      Decimal              @db.Decimal(12, 2)
  effectiveRate       Decimal              @db.Decimal(5, 4) // e.g., 0.0800 for 8%
  calculatedFee       Decimal              @db.Decimal(12, 2)
  status              CommissionStatus     @default(PENDING_DEPOSIT)
  isCappedTransition  Boolean              @default(false)
  depositProofTxId    String?              // Bank deposit or QBO Payment Reference
  triggeredAt         DateTime             @default(now())

  contractor          Contractor           @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  contract            Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractorId, contractId, status])
}
