{
  "name": "socio-os",
  "version": "1.0.0",
  "description": "Socio Operating System: DSH + Hermes Hybrid Agent Fleet",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "server": "node server.js",
    "setup": "bash setup_dsh.sh",
    "init-hermes": "bash init_hermes_fleet.sh",
    "test": "node --test 'engines/growth-os/tests/**/*.mjs' 'engines/prospect/tests/**/*.mjs' 'tests/**/*.test.cjs'",
    "migrate": "node engines/growth-os/migrations/migrate.mjs",
    "lint": "eslint engines/growth-os website/api scripts/verify-build.mjs eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "build:css": "tailwindcss -i website/assets/input.css -o website/assets/output.css --minify",
    "build:vite": "vite build",
    "build:all": "npm run build:css && npm run build",
    "check:links": "node scripts/check-site-links.mjs",
    "deploy": "node scripts/safe-deploy.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.0-rc.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "framer-motion": "^11.15.0",
    "pg": "^8.23.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0",
    "vite": "^8.2.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "author": "Socio",
  "license": "UNLICENSED"
}
