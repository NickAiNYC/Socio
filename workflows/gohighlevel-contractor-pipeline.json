{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "pipelineName": "Socio Contratistas NYC - Pilot Acquisition & Delivery",
  "crmPlatform": "GoHighLevel",
  "version": "1.0.0",
  "stages": [
    {
      "id": "stage_1_dob_scanned",
      "name": "1. DOB Permit Scanned / Inbound WhatsApp",
      "position": 1,
      "color": "#64748B",
      "automationTrigger": "WEBHOOK_INGEST"
    },
    {
      "id": "stage_2_leak_scan_generated",
      "name": "2. Escaneo de Fugas Generado (PDF)",
      "position": 2,
      "color": "#EAB308",
      "automationTrigger": "LEAK_SCAN_DELIVERED"
    },
    {
      "id": "stage_3_whatsapp_pitch_active",
      "name": "3. Secuencia WhatsApp Activa (Toque 1-3)",
      "position": 3,
      "color": "#3B82F6",
      "automationTrigger": "PITCH_AGENT_ENGAGED"
    },
    {
      "id": "stage_4_pilot_agreement_sent",
      "name": "4. Acuerdo Piloto Enviado (50% Desc)",
      "position": 4,
      "color": "#8B5CF6",
      "automationTrigger": "CONTRACT_DISPATCH"
    },
    {
      "id": "stage_5_onboarding_in_progress",
      "name": "5. Onboarding Activo (<7 Días)",
      "position": 5,
      "color": "#EC4899",
      "automationTrigger": "WHATSAPP_INTAKE"
    },
    {
      "id": "stage_6_live_qbo_connected",
      "name": "6. Activo / QuickBooks Vinculado (Gate 1 Passed)",
      "position": 6,
      "color": "#10B981",
      "automationTrigger": "QBO_OAUTH_CONFIRMED"
    },
    {
      "id": "stage_7_first_deposit_cleared",
      "name": "7. Primer Depósito Cobrado en Banco (Gate 2 Passed)",
      "position": 7,
      "color": "#059669",
      "automationTrigger": "COMMISSION_TRIGGERED"
    },
    {
      "id": "stage_8_churned_or_killed",
      "name": "8. Descalificado / Kill Gate Failed",
      "position": 8,
      "color": "#DC2626",
      "automationTrigger": "GATE_FAILED"
    }
  ],
  "customFields": [
    { "key": "contractor_borough", "name": "Borough", "type": "dropdown", "options": ["Queens", "Brooklyn", "Bronx", "Manhattan", "Staten Island"] },
    { "key": "license_dca_number", "name": "Licencia DCA / DOB", "type": "text" },
    { "key": "qbo_realm_id", "name": "QBO Realm ID", "type": "text" },
    { "key": "tracking_twilio_phone", "name": "Número de Tracking Dedicado", "type": "phone" },
    { "key": "pilot_discount_active", "name": "Piloto 50% Descuento", "type": "checkbox", "default": true },
    { "key": "annual_commission_cap", "name": "Tope Anual ($)", "type": "currency", "default": 40000 },
    { "key": "total_cleared_deposits", "name": "Depósitos Cobrados Acumulados ($)", "type": "currency", "default": 0 },
    { "key": "gate_1_status", "name": "Gate 1 (Día 45)", "type": "dropdown", "options": ["PENDING", "PASSED", "FAILED"] },
    { "key": "gate_2_status", "name": "Gate 2 (Día 90)", "type": "dropdown", "options": ["PENDING", "PASSED", "FAILED"] }
  ]
}
