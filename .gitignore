# Environment variables
.env
.env.local

# VPS credentials
id_rsa*
*.pem

# Agent data
~/.dsh/
~/.hermes/

# Backups
backups/
*.log
*.sql
# Migrations are source code — never ignore the schema.
!engines/growth-os/migrations/*.sql

# Runtime data (not source): server JSON DB + daily prospect packets.
# Packets are the runtime handoff artifact between Prospect and Pitch —
# generated per run, never committed.
outputs/socio_production.json
outputs/prospects/

# Node
node_modules/
package-lock.json
# Lockfile is source — required for reproducible npm ci (CI depends on it).
!/package-lock.json

# OS
.DS_Store
Thumbs.db

# Git worktrees (admin directories, not project content)
.worktrees/
.vercel
