    },
    {
      "src": "/proveedores/ferreterias/?",
      "dest": "website/proveedores/ferreterias.html"
    },
    {
      "src": "/proveedores/materiales/?",
      "dest": "website/proveedores/materiales.html"
    },
    {
      "src": "/proveedores/equipos/?",
      "dest": "website/proveedores/equipos.html"
    },
    {
      "src": "/global-brands/?",
      "dest": "website/global-brands.html"
    },
    {
      "src": "/command-center/?",
      "dest": "website/command-center.html"
    },
    {
      "src": "/merchant-evidence/?",
      "dest": "website/merchant-evidence.html"
    },
    {
      "src": "/trust-and-proof/?",
      "dest": "website/trust-and-proof.html"
    },
    {
      "src": "/manifest.json",
      "dest": "website/manifest.json"
    },
    {
      "src": "/sitemap.xml",
      "dest": "website/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "website/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "website/$1"
    }
  ]
}