{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "website/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/privacy",
      "dest": "server.js"
    },
    {
      "src": "/terms",
      "dest": "server.js"
    },
    {
      "src": "/recovery-index/?",
      "dest": "website/recovery-index.html"
    },
    {
      "src": "/contratistas/?",
      "dest": "website/contratistas.html"
    },
    {
      "src": "/floristas/?",
      "dest": "website/floristas.html"
    },
    {
      "src": "/floristas/como-funciona/?",
      "dest": "website/floristas/como-funciona.html"
    },
    {
      "src": "/floristas/casos-de-exito/?",
      "dest": "website/floristas/casos-de-exito.html"
    },
    {
      "src": "/floristas/radar-floral/?",
      "dest": "website/floristas/radar-floral.html"
    },
    {
      "src": "/floristas/preguntas-frecuentes/?",
      "dest": "website/floristas/preguntas-frecuentes.html"
    },
    {
      "src": "/restaurantes/?",
      "dest": "website/restaurantes.html"
    },
    {
      "src": "/restaurantes/como-funciona/?",
      "dest": "website/restaurantes/como-funciona.html"
    },
    {
      "src": "/restaurantes/casos-de-exito/?",
      "dest": "website/restaurantes/casos-de-exito.html"
    },
    {
      "src": "/restaurantes/radar-gastronomico/?",
      "dest": "website/restaurantes/radar-gastronomico.html"
    },
    {
      "src": "/restaurantes/preguntas-frecuentes/?",
      "dest": "website/restaurantes/preguntas-frecuentes.html"
    },
    {
      "src": "/clinicas/?",
      "dest": "website/clinicas.html"
    },
    {
      "src": "/clinicas/como-funciona/?",
      "dest": "website/clinicas/como-funciona.html"
    },
    {
      "src": "/clinicas/casos-de-exito/?",
      "dest": "website/clinicas/casos-de-exito.html"
    },
    {
      "src": "/clinicas/radar-pacientes/?",
      "dest": "website/clinicas/radar-pacientes.html"
    },
    {
      "src": "/clinicas/preguntas-frecuentes/?",
      "dest": "website/clinicas/preguntas-frecuentes.html"
    },
    {
      "src": "/escaneo-de-fugas-scorecard/?",
      "dest": "website/escaneo-de-fugas-scorecard.html"
    },
    {
      "src": "/supplier-cards/?",
      "dest": "website/supplier-cards.html"
    },
    {
      "src": "/pilot-agreement/?",
      "dest": "website/pilot-agreement.html"
    },
    {
      "src": "/contratistas/como-funciona/?",
      "dest": "website/contratistas/como-funciona.html"
    },
    {
      "src": "/contratistas/casos-de-exito/?",
      "dest": "website/contratistas/casos-de-exito.html"
    },
    {
      "src": "/contratistas/radar-de-permisos/?",
